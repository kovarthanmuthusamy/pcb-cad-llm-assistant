# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real keys. Every variable is optional unless noted;
# the defaults are the values the project was developed with (see src/pcb_assistant/config.py).

# ── Credentials ────────────────────────────────────────────────────────────
# OpenAI orchestrator (--provider openai)
OPENAI_API_KEY=

# Google Gemini orchestrator (--provider google) and Google Custom Search for the RAG web source
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Hugging Face token for downloading base models / private adapters
HF_TOKEN=

# ── Orchestrator models and sampling ───────────────────────────────────────
# PCB_ORCHESTRATOR_MODEL=deepseek-r1:70b   # --provider ollama
# PCB_OPENAI_MODEL=gpt-4o
# PCB_GOOGLE_MODEL=gemini-1.5-pro          # check that the model name is still served
# PCB_TEMPERATURE=0.7
# OLLAMA_HOST=http://localhost:11434      # Ollama server; Docker Compose sets http://ollama:11434

# ── PCB expert (not distributed: you need your own LoRA adapter) ───────────
PCB_EXPERT_BASE_MODEL=deepseek-ai/DeepSeek-R1-Distill-Llama-8B
PCB_EXPERT_ADAPTER_PATH=

# ── Vision (image -> text) ─────────────────────────────────────────────────
# PCB_VISION_MODEL_ID=ibm-granite/granite-vision-3.2-2b
# PCB_VISION_ADAPTER_PATH=                 # local LoRA adapter; base model is used if unset
# PCB_VISION_MAX_NEW_TOKENS=4000
# PCB_VISION_CUDA_DEVICE=                  # e.g. 1 to pin the vision model to GPU 1
# PCB_VISION_COMPILE=true                  # torch.compile; set false if Triton is unavailable

# ── RAG ────────────────────────────────────────────────────────────────────
# All vector stores and document folders live under this directory (gitignored).
# PCB_RAG_HOME=rag_data
# PCB_RAG_MODEL=deepseek-r1:32b
# PCB_RAG_ROUTER_MODEL=deepseek-r1:32b
# PCB_RAG_NUM_RESULTS=5
# PCB_RAG_SEARCH_ENGINE=duckDuckGo         # google, duckDuckGo, brave, bing, yahoo, startpage
# PCB_RAG_CLEANUP_DELAY_S=2                # pause after each RAG call; 0 disables
# PCB_EMBEDDING_MODEL=nomic-embed-text

# ── Simulation (Windows + eCADSTAR) ────────────────────────────────────────
# Local eCADSTAR templates and output directory used by the simulation adapter
ECADSTAR_P2P_SIDF=
ECADSTAR_P2P_TEMPLATE=
ECADSTAR_STAR_SIDF=
ECADSTAR_STAR_TEMPLATE=
# ECADSTAR_OUTPUT_DIR=simulation_images
# ECADSTAR_OPEN_WAIT_S=10                  # wait after opening the circuit file
# ECADSTAR_RUN_WAIT_S=10                   # wait for the simulation to finish
# PCB_SIM_MIN_SIMILARITY=0.3               # minimum semantic match for an analysis type

# ── Local web UI ───────────────────────────────────────────────────────────
# PCB_UI_DEBUG=false
# PCB_UI_HOST=127.0.0.1                   # the Docker image sets 0.0.0.0
# PCB_UI_PORT=5000
