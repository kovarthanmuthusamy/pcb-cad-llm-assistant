# Copy this file to `.env` and fill in your own credentials.
# `.env` is gitignored — never commit real keys.

# OpenAI orchestrator (openai_main.py)
OPENAI_API_KEY=

# Google Gemini orchestrator (google_main.py) and Google Custom Search RAG
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Hugging Face token for downloading base models / private adapters (PCB/PCB_expert.py)
HF_TOKEN=

# Local LoRA adapter used by PCB/PCB_expert.py (not distributed in this repository)
PCB_EXPERT_BASE_MODEL=deepseek-ai/DeepSeek-R1-Distill-Llama-8B
PCB_EXPERT_ADAPTER_PATH=

# Local eCADSTAR templates and output directory used by the Windows simulation adapter
ECADSTAR_P2P_SIDF=
ECADSTAR_P2P_TEMPLATE=
ECADSTAR_STAR_SIDF=
ECADSTAR_STAR_TEMPLATE=
ECADSTAR_OUTPUT_DIR=
